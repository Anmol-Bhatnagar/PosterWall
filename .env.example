# ============================================================
# PosterWall v2.0 — Environment Variables Template
# Copy this file to '.env' and fill in your credentials
# ============================================================

# App Environment (development, production)
APP_ENV=development
DEBUG_MODE=true

# Branding & Site Configuration
SITE_NAME=PosterWall
SITE_TAGLINE="Apna Design. Apna Brand. Apni Pehchaan."
COMPANY="Tech Eagles"
PARENT="Mahakumbrix Innovation"
SITE_URL=http://localhost/posterwall2
SUPPORT_EMAIL=support@posterwall.in
YEAR=2026

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=posterwall2

# AI Services Configuration
# AI_PROVIDER can be 'openrouter' or 'groq'
AI_PROVIDER=openrouter

# OpenRouter Settings (Get key from openrouter.ai)
OR_API_KEY=
OR_API_URL=https://openrouter.ai/api/v1/chat/completions

# Groq Settings (Get key from console.groq.com)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_HTML_MODEL=llama-3.3-70b-versatile

# AI Models (Free models are default)
OR_VISION_MODEL=google/gemini-2.0-flash-exp:free
OR_FALLBACK_VISION=google/gemini-flash-1.5
OR_HTML_MODEL=meta-llama/llama-3.3-70b-instruct:free
OR_FALLBACK_HTML=meta-llama/llama-3.1-8b-instruct:free
OR_MAX_TOKENS=4096

# Razorpay Configuration (Get from razorpay.com dashboard)
RZP_KEY_ID=
RZP_KEY_SECRET=

# Google OAuth Configuration (Get from Google Cloud Console Credentials)
G_CLIENT_ID=
G_CLIENT_SECRET=
G_REDIRECT=http://localhost/posterwall2/auth/callback.php

# Pricing Setting
PAGE_COST=9
